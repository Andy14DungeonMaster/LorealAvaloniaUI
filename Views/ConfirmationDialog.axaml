<Window
    x:Class="LorealAvaloniaUI.Views.ConfirmationDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:LorealAvaloniaUI.Views"
	xmlns:res="clr-namespace:LorealAvaloniaUI.Lang;assembly=LorealAvaloniaUI"
    x:DataType="vm:ConfirmationDialogViewModel"
    Title="{x:Static res:Resources.ConfirmationDialogTitle}"
    Width="400"
    SizeToContent="Height"
    CanResize="False"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <TextBlock
            Grid.Row="0"
            Text="{Binding Message}"
            TextWrapping="Wrap"
            VerticalAlignment="Center" />
        
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="10"
            Margin="0,20,0,0">
            <Button
                Content="{x:Static res:Resources.YesButtonContent}"
                Command="{Binding ConfirmCommand}"
                Width="80" />
            <Button
                Content="{x:Static res:Resources.NoButtonContent}"
                Command="{Binding CancelCommand}"
                Width="80" />
        </StackPanel>
    </Grid>
</Window>