<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="clr-namespace:LorealAvaloniaUI.ViewModels"
             x:Class="LorealAvaloniaUI.Views.OneDriveView"
			 x:DataType="vm:OneDriveViewModel">
	<StackPanel>
		<TabControl Margin="5">
			<TabItem Header="Desktop">
				<StackPanel>
					<!-- File List using ItemsControl -->
					<!-- File Summary -->
					<StackPanel Orientation="Vertical" Margin="0,10,0,10">
						<TextBlock Text="No of files with size >500 MB: 28" Foreground="White" FontSize="16"/>
						<TextBlock Text="Total size of the files: 14 GB" Foreground="White" FontSize="16"/>
					</StackPanel>


					<ItemsControl ItemsSource="{Binding DesktopFiles}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid ColumnDefinitions="40, *, 120, 200" Height="40" Background="{Binding RowBackground}" Margin="0,5,0,0">
									<CheckBox Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="{Binding IsSelected}"/>
									<TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="White" VerticalAlignment="Center"/>
									<TextBlock Grid.Column="2" Text="{Binding FileSize}" Foreground="White" VerticalAlignment="Center"/>
									<TextBlock Grid.Column="3" Text="{Binding LastModified}" Foreground="White" VerticalAlignment="Center"/>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<StackPanel Orientation="Horizontal" Spacing="10" Margin="0,20,0,0" HorizontalAlignment="Right">
						<TextBlock Text="Size Selected: 3 GB" Foreground="DodgerBlue" FontSize="16"/>
						<Button Content="Free up selected disk space" Background="#4444FF" Foreground="White" Padding="10,5"/>
					</StackPanel>

					<Border Background="#333" CornerRadius="10" Height="120" Margin="5">
						<StackPanel>
							<TextBlock Margin="10,10,10,10" xml:space="preserve" >Free up disk space by removing locally cached files on this device. The files will<LineBreak/> remain On-Demand and can easily be accesses by opening the file agian.
						</TextBlock>
							<Button HorizontalAlignment="Right" Margin="10,10,10,10" Content="Free up disk space" Background="#4444FF" Foreground="White" Padding="10,5"/>

						</StackPanel>
					</Border>

				</StackPanel>
			</TabItem>
			<TabItem Header="Documents">
				<TextBlock Margin="5">This is tab 2 content</TextBlock>
			</TabItem>
			<TabItem Header="Pictures">
				<TextBlock Margin="5">This is tab 3 content</TextBlock>
			</TabItem>
			<TabItem Header="Recordings">
				<TextBlock Margin="5">This is tab 3 content</TextBlock>
			</TabItem>
		</TabControl>
	</StackPanel>
</UserControl>
