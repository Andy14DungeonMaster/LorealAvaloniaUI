<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LorealAvaloniaUI.ViewModels;assembly=LorealAvaloniaUI"
             x:Class="LorealAvaloniaUI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <StackPanel Spacing="15" Margin="20">
        <!-- Header -->
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Image Source="avares://LorealAvaloniaUI/Assets/warning_icon.png" Width="24" Height="24" />
            <TextBlock Text="{Binding HeaderMessage}" Foreground="{Binding StorageTextColor}" FontSize="20" FontWeight="Bold" />
        </StackPanel>

        <!-- Progress Bar -->
        <ProgressBar Minimum="0" 
                     Maximum="{Binding TotalStorageGB}" 
                     Value="{Binding UsedStorageGB}" 
                     Foreground="{Binding ProgressBarColor}" 
                     Height="10" />
		<Grid>
        <TextBlock Grid.Column ="1" Text="{Binding StorageUsageText}" Foreground="White" FontSize="14" />
        <TextBlock Grid.Column="2" Text="{Binding FreeStorageText}" Foreground="White" FontSize="14" HorizontalAlignment="Right" />
		</Grid>
        <!-- Storage Sections (Fixed ColumnDefinitions) -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Downloads -->
            <Border Background="#1E1E1E" CornerRadius="10" Height="120" Grid.Column="0" Padding="15">
                <StackPanel Spacing="5" HorizontalAlignment="Stretch">
                    <Image Source="avares://LorealAvaloniaUI/Assets/downloads_icon.png" Width="40" Height="40"/>
                    <TextBlock Text="Downloads" HorizontalAlignment="Center" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <Button Content="Free up space" Background="#333" Foreground="White"
                            HorizontalAlignment="Stretch" Padding="10,5" Command="{Binding FreeUpDownloadsCommand}"/>
                </StackPanel>
            </Border>

            <!-- One Drive -->
            <Border Background="#1E1E1E" CornerRadius="10" Height="120" Grid.Column="2" Padding="15">
                <StackPanel Spacing="5" HorizontalAlignment="Stretch">
                    <Image Source="avares://LorealAvaloniaUI/Assets/onedrive_icon.png" Width="40" Height="40"/>
                    <TextBlock Text="OneDrive" HorizontalAlignment="Center" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <Button Content="Free local space" Background="#333" Foreground="White"
                            HorizontalAlignment="Stretch" Padding="10,5" Command="{Binding FreeUpOneDriveCommand}"/>
                </StackPanel>
            </Border>

            <!-- Outlook -->
            <Border Background="#1E1E1E" CornerRadius="10" Height="120" Grid.Column="4" Padding="15">
                <StackPanel Spacing="5" HorizontalAlignment="Stretch">
                    <Image Source="avares://LorealAvaloniaUI/Assets/outlook_icon.png" Width="40" Height="40"/>
                    <TextBlock Text="Outlook" HorizontalAlignment="Center" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <Button Content="Show details" Background="#333" Foreground="White"
                            HorizontalAlignment="Stretch" Padding="10,5" Command="{Binding ShowOutlookDetailsCommand}"/>
                </StackPanel>
            </Border>

            <!-- Office Files cache -->
            <Border Background="#1E1E1E" CornerRadius="10" Height="120" Grid.Column="6" Padding="15">
                <StackPanel Spacing="5" HorizontalAlignment="Stretch">
                    <Image Source="avares://LorealAvaloniaUI/Assets/officefiles_icon.png" Width="40" Height="40"/>
                    <TextBlock Text="Office Cache Files" HorizontalAlignment="Center" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <Button Content="Show details" Background="#333" Foreground="White"
                            HorizontalAlignment="Stretch" Padding="10,5" Command="{Binding ShowOfficeCacheDetailsCommand}"/>
                </StackPanel>
            </Border>

		</Grid>
        <!-- Cleanup Summary -->
		<StackPanel >
        <TextBlock Text="Previous clean up summary:" FontStyle="Italic" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,10,0,0"/>
        <TextBlock Text="{Binding CleanupDate, StringFormat='Date: {0:f}'}" Foreground="White" FontSize="14"/>
        <TextBlock Text="{Binding DeletedFileCount, StringFormat='No. of files deleted: {0}'}" Foreground="White" FontSize="14"/>
			<TextBlock Text="{Binding ClearedSpace, StringFormat='Size of the deleted files: {0} GB'}" Foreground="White" FontSize="14"/>
			<TextBlock Text="{Binding UncachedFileCount, StringFormat='No. of OneDrive files uncached through selection: {0} '}" Foreground="White" FontSize="14"/>
			<TextBlock Text="{Binding UncachedSpace, StringFormat='Size of the OneDrive uncached files through selection: {0} GB'}" Foreground="White" FontSize="14"/>
			<TextBlock Text="{Binding TotalAvailableAfterCleanup}" Foreground="White" FontSize="14"/>
		</StackPanel>

    </StackPanel>
</UserControl>