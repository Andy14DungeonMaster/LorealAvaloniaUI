<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LorealAvaloniaUI.ViewModels;assembly=LorealAvaloniaUI"
			 xmlns:res="clr-namespace:LorealAvaloniaUI.Lang;assembly=LorealAvaloniaUI"
             x:Class="LorealAvaloniaUI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <StackPanel Spacing="15" Margin="20">
        <!-- Header -->
		<StackPanel Orientation="Vertical" Spacing="5" VerticalAlignment="Center">
			<!-- This StackPanel "fuses" the Image and the HeaderMessage TextBlock -->
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
				<Image Source="avares://LorealAvaloniaUI/Assets/warning_icon.png"
					   Width="24" Height="24"
					   VerticalAlignment="Center"
					   Margin="0,0,5,0" />
				<!-- Small right margin for spacing -->

				<TextBlock Text="{Binding HeaderMessage}"
						   Foreground="{Binding StorageTextColor}"
						   FontSize="20" FontWeight="Bold"
						   VerticalAlignment="Center" />
			</StackPanel>

			<!-- This TextBlock is displayed below the "fused" image and header -->
			<TextBlock Text="{Binding UserInstructionMessage}"
					   Foreground="{Binding StorageTextColor}"
					   FontSize="14" FontWeight="Regular"
					   TextWrapping="Wrap"
					   Margin="0,5,0,0" />
			<!-- Small top margin for spacing -->
		</StackPanel>
        <!-- Progress Bar -->
        <ProgressBar Minimum="0" 
                     Maximum="{Binding TotalStorageGB}" 
                     Value="{Binding UsedStorageGB}" 
                     Foreground="{Binding ProgressBarColor}" 
                     Height="10" />
		<Grid>
        <TextBlock Grid.Column ="1" Text="{Binding StorageUsageText}" Foreground="White" FontSize="14" />
        <TextBlock Grid.Column="2" Text="{Binding FreeStorageText}" Foreground="White" FontSize="14" HorizontalAlignment="Right" />
		</Grid>
        <!-- Storage Sections (Fixed ColumnDefinitions) -->
        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Downloads -->
            <Border Background="#1E1E1E" CornerRadius="10" Height="140" Grid.Column="0" Padding="10">
                <StackPanel Spacing="5" HorizontalAlignment="Stretch">
                    <Image Source="avares://LorealAvaloniaUI/Assets/downloads_icon.png" Width="40" Height="40"/>
                    <TextBlock Text="{x:Static res:Resources.DownloadsTitle}" HorizontalAlignment="Center" Foreground="White" FontSize="16" FontWeight="Bold"/>
					<TextBlock Text="{Binding DownloadsFolderSize, StringFormat={x:Static res:Resources.SizeDisplay}}" HorizontalAlignment="Center" Foreground="White" FontSize="14" FontWeight="Bold"/>
					<Button Content="{x:Static res:Resources.DOFCButtonText}" Background="#333" Foreground="White" HorizontalContentAlignment="Center"
                            HorizontalAlignment="Stretch" Padding="10,5" Command="{Binding FreeUpDownloadsCommand}"/>
                </StackPanel>
            </Border>

			<!-- Office Files cache -->
			<Border Background="#1E1E1E" CornerRadius="10" Height="140" Grid.Column="2" Padding="10">
				<StackPanel Spacing="5" HorizontalAlignment="Stretch">
					<Image Source="avares://LorealAvaloniaUI/Assets/officefiles_icon.png" Width="40" Height="40"/>
					<TextBlock Text="{x:Static res:Resources.OfficeFilesCacheTitle}" HorizontalAlignment="Center" Foreground="White" FontSize="16" FontWeight="Bold" TextWrapping="NoWrap"/>
					<TextBlock Text="{Binding OfficeCacheFolderSize, StringFormat={x:Static res:Resources.SizeDisplay}}" HorizontalAlignment="Center" Foreground="White" FontSize="14" FontWeight="Bold"/>
					<Button Content="{x:Static res:Resources.DOFCButtonText}" Background="#333" Foreground="White" HorizontalContentAlignment="Center"
                            HorizontalAlignment="Stretch" Padding="10,5" Command="{Binding ShowOfficeCacheDetailsCommand}"/>
				</StackPanel>
			</Border>

            <!-- One Drive -->
            <Border Background="#1E1E1E" CornerRadius="10" Height="140" Grid.Column="4" Padding="15">
                <StackPanel Spacing="5" HorizontalAlignment="Stretch">
                    <Image Source="avares://LorealAvaloniaUI/Assets/onedrive_icon.png" Width="40" Height="40"/>
                    <TextBlock Text="OneDrive" HorizontalAlignment="Center" Foreground="White" FontSize="16" FontWeight="Bold"/>
					<Button Background="#333" Foreground="White"
                 HorizontalAlignment="Stretch" Padding="10,5" Command="{Binding FreeUpOneDriveCommand}">
						<TextBlock Text="{x:Static res:Resources.OneDriveButtonText}"
								   TextWrapping="Wrap"           
						TextAlignment="Center"        
						VerticalAlignment="Center"   
						HorizontalAlignment="Center"  
						MaxLines="2"/>                
					</Button>
                </StackPanel>
            </Border>

            <!-- Outlook -->
            <Border Background="#1E1E1E" CornerRadius="10" Height="140" Grid.Column="6" Padding="15">
                <StackPanel Spacing="5" HorizontalAlignment="Stretch">
                    <Image Source="avares://LorealAvaloniaUI/Assets/outlook_icon.png" Width="40" Height="40"/>
                    <TextBlock Text="Outlook" HorizontalAlignment="Center" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <Button Content="{x:Static res:Resources.OutlookButtonText}" Background="#333" Foreground="White" HorizontalContentAlignment="Center"
                            HorizontalAlignment="Stretch" Padding="10,5" Command="{Binding ShowOutlookDetailsCommand}"/>
                </StackPanel>
            </Border>

           

		</Grid>
        <!-- Cleanup Summary -->
		<StackPanel >
        <TextBlock Text="{x:Static res:Resources.SummaryHeader}" FontStyle="Italic" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,10,0,0"/>
        <TextBlock Text="{Binding CleanupDate, StringFormat={x:Static res:Resources.CleanupDateFormat}}" Foreground="White" FontSize="14"/>
        <TextBlock Text="{Binding DeletedFileCount, StringFormat={x:Static res:Resources.DeletedFileCountFormat}}" Foreground="White" FontSize="14"/>
			<TextBlock Text="{Binding ClearedSpace, StringFormat={x:Static res:Resources.DeletedFileSizeFormat}}" Foreground="White" FontSize="14"/>
			<TextBlock Text="{Binding UncachedFileCount, StringFormat={x:Static res:Resources.UncachedFileCountFormat}}" Foreground="White" FontSize="14"/>
			<TextBlock Text="{Binding UncachedSpace, StringFormat={x:Static res:Resources.UncachedSpaceFormat}}" Foreground="White" FontSize="14"/>
			<TextBlock Text="{Binding TotalAvailableAfterCleanup}" Foreground="White" FontSize="14"/>
		</StackPanel>

    </StackPanel>
</UserControl>