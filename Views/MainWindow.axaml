<Window
    x:Class="LorealAvaloniaUI.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:LorealAvaloniaUI.ViewModels"
    Title="L'ORÉAL DISK CLEANUP"

    x:DataType="vm:MainViewModel"
    Background="#222223"
	Loaded="Window_Loaded">

    <Grid ColumnDefinitions="250, *" RowDefinitions="50, *">

        <!--  Header Section  -->
        <Border
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Padding="10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Offset="0.0" Color="#4353EA" />
                    <GradientStop Offset="0.4" Color="#2FA5DF" />
                    <GradientStop Offset="1.0" Color="#40E16B" />

                </LinearGradientBrush>
            </Border.Background>

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="LOREAL Essentielle"
                FontSize="24"
                FontWeight="Normal"
                Foreground="White"
                Text="L'ORÉAL DISK CLEANUP" />
        </Border>

        <!--  Sidebar with TreeView  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
			Margin="0,10,0,0"
            Background="#222223">
            <TreeView ItemsSource="{Binding MenuItems}" SelectedItem="{Binding SelectedMenuItem}" Margin="0,0,0,0">
				<TreeView.Styles>
					<Style Selector="TreeView">
						<Setter Property="HorizontalAlignment" Value="Stretch"/>
						
					</Style>
				</TreeView.Styles>
                <TreeView.DataTemplates>
                    <TreeDataTemplate DataType="vm:MenuItemViewModel" ItemsSource="{Binding Children}" >
						<Border
						   HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
						   	Cursor="Hand"
							PointerPressed="OnMenuItemClicked"
							Height="30"
						   >
							<TextBlock Foreground="White"
									   Text="{Binding Title}"
									   VerticalAlignment="Center"
									   FontSize="16"
									   />
						</Border>
                    </TreeDataTemplate>
                </TreeView.DataTemplates>
            </TreeView>
        </Border>

        <!--  Main Content  -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Background="Black">
            <ContentControl Name="MainContent" />
        </Border>

    </Grid>
</Window>
