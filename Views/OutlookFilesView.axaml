<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LorealAvaloniaUI.ViewModels"
             x:Class="LorealAvaloniaUI.Views.OutlookFilesView"
             x:DataType="vm:OutlookFilesViewModel">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<ProgressBar Grid.Row ="0" IsVisible="{Binding IsLoading}" IsIndeterminate="True" />
		<TextBlock Grid.Row="1" Text="{Binding outlookStatus}" Foreground="#FF4500" TextWrapping="Wrap"/> 
		<Grid Grid.Row="2" Height="40" Margin="0,10,0,0" Background="Black" ColumnDefinitions="*,120, 120, *">
			<TextBlock Grid.Column="0" Text="File Name" Padding="5" Foreground="DodgerBlue" FontWeight="Bold" VerticalAlignment="Center"/>
			<TextBlock Grid.Column="1" Text="Size (MB)" Foreground="DodgerBlue" FontWeight="Bold" VerticalAlignment="Center"/>
			<TextBlock Grid.Column="2" Text="Extension" Foreground="DodgerBlue" FontWeight="Bold" VerticalAlignment="Center"/>
			<TextBlock Grid.Column="3" Text="File Path" Foreground="DodgerBlue" FontWeight="Bold" VerticalAlignment="Center"/>

			
		</Grid>

		<ItemsControl Grid.Row="3" ItemsSource="{Binding OutlookFiles}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Grid ColumnDefinitions="*, 120, 120, *" Height="40" Background="#1a1a1a" Margin="0,5,0,0">
						<TextBlock Grid.Column="0"
                                   Text="{Binding FileName}"
								   Padding="5"
                                   Foreground="White"
                                   VerticalAlignment="Center" />
						<TextBlock Grid.Column="1"
                                   Text="{Binding FileSizeMB, StringFormat='{}{0:F2} MB'}"
								   Padding="5"
                                   Foreground="White"
                                   VerticalAlignment="Center" />
						<TextBlock Grid.Column="2"
                                   Text="{Binding Extension}"
                                   Foreground="White"
                                   VerticalAlignment="Center" />
						<TextBlock Grid.Column="3"
		   Text="{Binding FilePath}"
		   Foreground="White"
		   VerticalAlignment="Center" />
					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
		</Grid> 
  
</UserControl>