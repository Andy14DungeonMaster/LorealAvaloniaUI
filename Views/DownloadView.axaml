<UserControl
    x:Class="LorealAvaloniaUI.Views.DownloadView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:LorealAvaloniaUI.ViewModels"
    x:DataType="vm:DownloadViewModel">
	
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> 
            <!--  Summary  -->
            <RowDefinition Height="Auto" /> 
            <!--  Sort/Filter  -->
            <RowDefinition Height="Auto" /> 
            <!--  Headers  -->
            <RowDefinition Height="*" />    
            <!--  Scrollable List  -->
            <RowDefinition Height="Auto" /> 
            <!--  Action Buttons  -->
        </Grid.RowDefinitions>

        <!--  File Summary  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,10,0,10"
            Orientation="Vertical">
            <TextBlock
                x:Name="TotalNumberTextBlock"
                FontSize="16"
                Foreground="White"
                Text="{Binding TotalNumber}" />
            <TextBlock
                FontSize="16"
                Foreground="White"
                Text="{Binding TotalDownloadsSize}" />
        </StackPanel>

        <!--  Table Headers  -->
        <Grid
            Grid.Row="2"
            Height="40"
            Margin="0,10,0,0"
            Background="Black"
            ColumnDefinitions="40, *, 120, 200">
            <CheckBox
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsChecked="{Binding SelectAll, Mode=TwoWay}" />

            <!-- Sortable File Name Header -->
            <Button Grid.Column="1" Padding="0" Background="Transparent" Command="{Binding SortFilesCommand}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="File Name" Foreground="DodgerBlue" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Image Source="avares://LorealAvaloniaUI/Assets/sort_icon.png" Width="15" Height="15" Margin="0,0,5,0"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Padding="0" Background="Transparent" Command="{Binding SortFilesBySizeCommand}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Size" Foreground="DodgerBlue" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Image Source="avares://LorealAvaloniaUI/Assets/sort_icon.png" Width="15" Height="15" Margin="0,0,5,0"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Padding="0" Background="Transparent" Command="{Binding SortFilesByDateCommand}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Last Modified" Foreground="DodgerBlue" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Image Source="avares://LorealAvaloniaUI/Assets/sort_icon.png" Width="15" Height="15" Margin="0,0,5,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <!--  Scrollable File List  -->
        <ScrollViewer
            Grid.Row="3"
            Margin="0,5,0,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Files}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Height="40"
                            Margin="0,5,0,0"
                            Background="{Binding RowBackground}"
                            ColumnDefinitions="40, *, 120, 200">
                            <CheckBox
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsSelected}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Padding="0"
                                Text="{Binding FileName}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="White"
								Padding="10"
                                Text="{Binding FileSize, StringFormat='{}{0} MB'}" />
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Text="{Binding LastModified, StringFormat='{}{0:g}'}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  Action Buttons  -->
        <StackPanel
            Grid.Row="4"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="10">
			<TextBlock
	            FontSize="16"
	            Foreground="DodgerBlue"
				Padding="10"
	            Text="Size Selected" />
            <TextBlock
                FontSize="16"
                Foreground="DodgerBlue"
				Padding="10"
                Text="{Binding 
				}" />
            <Button
                Padding="10,5"
                Background="#FF4444"
                Command="{Binding DeleteSelectedFilesCommand}"
                Content="Permanent Delete"
                Foreground="White" />
            <Button
                Padding="10,5"
                Background="#4444FF"
                Command="{Binding MoveSelectedFilesCommand}"
                Content="Move to OneDrive"
                Foreground="White" />
        </StackPanel>
    </Grid>
</UserControl>